# ============================================
# Nour al-Islam - Variables d'environnement
# ============================================
# 
# INSTRUCTIONS :
# 1. Copier ce fichier en `.env`
# 2. Remplacer les valeurs par tes vraies clés
# 3. NE JAMAIS commiter le fichier `.env`
#
# Obtenir tes clés sur :
# https://supabase.com/dashboard/project/_/settings/api
#
# ============================================

# URL de ton projet Supabase
SUPABASE_URL=your_supabase_url_here

# Clé publique (anon key / publishable key)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
